# API base URLs (include trailing slash if your deployment expects it)
VITE_APP_AUTH_API_URL=https://localhost/auth/
VITE_APP_MONITORING_API_URL=https://localhost/monitoring/
VITE_APP_NOTIFICATION_API_URL=https://localhost/notification/
VITE_APP_METRICS_API_URL=https://localhost/metrics/
VITE_APP_FINOPS_API_URL=https://localhost/finops/

# Azure AD / MSAL
VITE_APP_TENANT_ID=
VITE_APP_CLIENT_ID=
VITE_APP_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_APP_REDIRECT_URI=http://localhost:5173
VITE_MSAL_SCOPES=

# App
VITE_APP_INSTANCE=local
VITE_APP_VERSION=0.0.0
VITE_APP_DEV_TOOLS=false
VITE_APP_METRICS_ENABLED=true
VITE_APP_QR_CODE=false

